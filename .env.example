# .env.example
# Copy this file to .env.local and fill in the real values.

# Supabase public URL (e.g., https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_URL

# Supabase anon/public key (client‑side only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key – used only on the server (Vercel env vars)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY


