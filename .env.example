# .env.example
# Copie ce fichier en .env.local et remplis les vraies valeurs.
# Sur Vercel : mêmes variables dans Settings → Environment Variables.
# Ne préfixe JAMAIS SUPABASE_SERVICE_ROLE_KEY ni AI_API_KEY par NEXT_PUBLIC_.

# --- Supabase ---------------------------------------------------------------
# URL publique du projet (ex : https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_URL

# Clé anon/publique (utilisée côté navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Clé service role — serveur uniquement (routes API)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Site -------------------------------------------------------------------
# URL publique du site (redirections d'authentification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (n'importe quelle API compatible OpenAI /chat/completions) -------------
# Option recommandée : Qwen « qwen-flash » via Alibaba Cloud Model Studio (international)
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash
#
# Alternative : DeepSeek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# Clé API du fournisseur — serveur uniquement.
# Vide en local → mode démo (renvoie une leçon d'exemple). Obligatoire en production.
AI_API_KEY=

# Délai max d'une génération en millisecondes (défaut : 240000 = 4 min)
AI_TIMEOUT_MS=240000

# Force le mode démo même avec une clé (1 = oui)
# AI_DEMO=1
