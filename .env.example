# .env.example — toutes les variables lues par le code (aucune vraie valeur ici).
# Copie ce fichier en .env.local et remplis-le. Sur Vercel : mêmes variables dans
# Settings → Environment Variables (Production et Preview), puis redéploie.
# Ne préfixe JAMAIS SUPABASE_SERVICE_ROLE_KEY ni AI_API_KEY par NEXT_PUBLIC_ (elles
# seraient envoyées au navigateur).
#
# Dev avec le Supabase local (pnpm db:start) : mets les valeurs locales dans
# .env.development.local (prioritaire sur .env.local pour `pnpm dev` seulement) :
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 + les clés données par `supabase status -o env`.
#
# NODE_ENV est aussi lu, mais Next.js et Vercel le règlent tout seuls : ne le définis pas.

# --- Supabase ---------------------------------------------------------------
# URL du projet (Settings → API), ex. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clé anon / publishable : publique (navigateur, et lecture de la session côté serveur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Clé service_role / secret : serveur uniquement (routes API, scripts/bootstrap-owner.mjs).
# Donne un accès complet à la base.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Site -------------------------------------------------------------------
# URL publique de l'app, sans / final. OBLIGATOIRE en production :
#   NEXT_PUBLIC_SITE_URL=https://fluent-flow-mu.vercel.app
# Jamais localhost en production. Sert au lien de connexion du script bootstrap-owner
# (défaut http://localhost:3000), aux liens « Espace prof » / « Retour à l'application » du
# back office, et aux liens d'invitation créés depuis un sous-domaine de back office (sur le
# domaine principal, ils reprennent l'adresse de la requête). Figée au build : redéploie
# après un changement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (n'importe quelle API compatible OpenAI /chat/completions) ------------
# Recommandé : OpenRouter + Qwen (ce sont aussi les valeurs par défaut). Avec OpenRouter,
# le coût réel de chaque appel est demandé (usage.include) et suivi dans le back office.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3.7-flash
#
# Alternatives (même format ; coût alors estimé avec AI_PRICE_* ci-dessous) :
# - Alibaba Model Studio en direct (vérification d'identité requise) :
#   AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-flash
#   (clé « sk-ws-… » d'espace de travail : utiliser l'URL de l'espace, ws-….maas.aliyuncs.com/compatible-mode/v1)
# - DeepSeek : AI_BASE_URL=https://api.deepseek.com   AI_MODEL=deepseek-flash

# Clé API du fournisseur (OpenRouter : sk-or-…) — serveur uniquement.
# Obligatoire en production. Vide hors production → mode démo (leçon et plan d'exemple).
AI_API_KEY=

# Budget total d'une génération en millisecondes, relances comprises.
# Défaut 240000 (4 min), plafonné à 270000 (les routes IA ont maxDuration = 300 s).
# AI_TIMEOUT_MS=240000

# Nombre max de tokens de la réponse (max_tokens). Défaut 8192 : à augmenter si des leçons
# avec beaucoup d'exercices reviennent coupées.
# AI_MAX_TOKENS=8192

# 1 = mode démo même avec une clé (aucun appel à l'IA). Ignoré en production.
# AI_DEMO=1

# Prix en USD par million de tokens, pour estimer le coût des appels sans coût réel
# (autre fournisseur qu'OpenRouter, anciennes leçons). Défauts : 0.05 en entrée, 0.40 en sortie.
# AI_PRICE_INPUT_PER_M=0.05
# AI_PRICE_OUTPUT_PER_M=0.40

# --- Back office --------------------------------------------------------------
# Optionnel. Le back office est sous /admin sur le domaine de l'app
# (https://fluent-flow-mu.vercel.app/admin) ; accès : app_metadata.is_admin = true
# (scripts/bootstrap-owner.mjs). Cette variable ne sert que pour un sous-domaine dédié :
# sur ces domaines (séparés par des virgules), tout reste sous /admin.
# Défaut : backoffice.localhost (en local : http://backoffice.localhost:3000). Si tu la
# définis, ajoute backoffice.localhost à la liste pour garder l'accès local.
# BACKOFFICE_HOSTS=backoffice.example.com,backoffice.localhost

# --- Emails transactionnels (Resend) ------------------------------------------
# Clé API Resend (serveur uniquement). Vide = mode démo (logs dans la console).
# RESEND_API_KEY=re_...
# Adresse d'envoi par défaut (ex. FluentFlow <onboarding@resend.dev> ou domaine vérifié)
# EMAIL_FROM=FluentFlow <onboarding@resend.dev>

